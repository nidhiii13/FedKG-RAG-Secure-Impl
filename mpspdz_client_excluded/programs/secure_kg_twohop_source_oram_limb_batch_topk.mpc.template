from Compiler.library import for_range, print_ln
from Compiler.oram import OptimalORAM
from Compiler.types import Array, sint

program.use_edabit(True)

DATA_PARTIES = {data_parties}
NUM_QUERIES = {num_queries}
DIRECTORY_CAPACITY = {directory_capacity}
SOURCE_EDGE_CAPACITY = {source_edge_capacity}
PROBE_LIMIT = {probe_limit}
MAX_CANDIDATES = {max_candidates}
TOP_K = {top_k}

DIRECTORY_TOTAL = DIRECTORY_CAPACITY * DATA_PARTIES
SOURCE_EDGE_TOTAL = SOURCE_EDGE_CAPACITY * DATA_PARTIES
CANDIDATE_TOTAL = MAX_CANDIDATES * DATA_PARTIES

query_source_0 = Array(NUM_QUERIES, sint)
query_source_1 = Array(NUM_QUERIES, sint)
query_source_2 = Array(NUM_QUERIES, sint)
query_source_3 = Array(NUM_QUERIES, sint)
query_relation_1_0 = Array(NUM_QUERIES, sint)
query_relation_1_1 = Array(NUM_QUERIES, sint)
query_relation_1_2 = Array(NUM_QUERIES, sint)
query_relation_1_3 = Array(NUM_QUERIES, sint)
query_direction_1 = Array(NUM_QUERIES, sint)
query_relation_2_0 = Array(NUM_QUERIES, sint)
query_relation_2_1 = Array(NUM_QUERIES, sint)
query_relation_2_2 = Array(NUM_QUERIES, sint)
query_relation_2_3 = Array(NUM_QUERIES, sint)
query_reverse_direction_2 = Array(NUM_QUERIES, sint)
query_target_0 = Array(NUM_QUERIES, sint)
query_target_1 = Array(NUM_QUERIES, sint)
query_target_2 = Array(NUM_QUERIES, sint)
query_target_3 = Array(NUM_QUERIES, sint)
target_is_unknown = Array(NUM_QUERIES, sint)
type_identity_mode = Array(NUM_QUERIES, sint)
source_probe_slots = Array(NUM_QUERIES * PROBE_LIMIT, sint)
reverse_probe_slots = Array(NUM_QUERIES * PROBE_LIMIT, sint)

for query in range(NUM_QUERIES):
    query_source_0[query] = sint.get_input_from(0)
    query_source_1[query] = sint.get_input_from(0)
    query_source_2[query] = sint.get_input_from(0)
    query_source_3[query] = sint.get_input_from(0)
    query_relation_1_0[query] = sint.get_input_from(0)
    query_relation_1_1[query] = sint.get_input_from(0)
    query_relation_1_2[query] = sint.get_input_from(0)
    query_relation_1_3[query] = sint.get_input_from(0)
    query_direction_1[query] = sint.get_input_from(0)
    query_relation_2_0[query] = sint.get_input_from(0)
    query_relation_2_1[query] = sint.get_input_from(0)
    query_relation_2_2[query] = sint.get_input_from(0)
    query_relation_2_3[query] = sint.get_input_from(0)
    query_reverse_direction_2[query] = sint.get_input_from(0)
    query_target_0[query] = sint.get_input_from(0)
    query_target_1[query] = sint.get_input_from(0)
    query_target_2[query] = sint.get_input_from(0)
    query_target_3[query] = sint.get_input_from(0)
    target_is_unknown[query] = sint.get_input_from(0)
    type_identity_mode[query] = sint.get_input_from(0)
    for probe in range(PROBE_LIMIT):
        source_probe_slots[query * PROBE_LIMIT + probe] = sint.get_input_from(0)
    for probe in range(PROBE_LIMIT):
        reverse_probe_slots[query * PROBE_LIMIT + probe] = sint.get_input_from(0)

directory_entry_size = (32, 32, 32, 32, 32, 32, 32, 32, 1, {source_edge_index_bits}, {candidate_count_bits}, 1)
edge_entry_size = (32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 61, 1)

source_directory = OptimalORAM(DIRECTORY_TOTAL, entry_size=directory_entry_size)
source_edges = OptimalORAM(SOURCE_EDGE_TOTAL, entry_size=edge_entry_size)

for party_offset in range(DATA_PARTIES):
    player = party_offset + 1
    directory_base = party_offset * DIRECTORY_CAPACITY

    @for_range(DIRECTORY_CAPACITY)
    def _(slot):
        source_directory[directory_base + slot] = tuple(
            sint.get_input_from(player) for _ in range(12)
        )

    source_base = party_offset * SOURCE_EDGE_CAPACITY

    @for_range(SOURCE_EDGE_CAPACITY)
    def _(slot):
        source_edges[source_base + slot] = tuple(
            sint.get_input_from(player) for _ in range(14)
        )

left_source_0 = Array(CANDIDATE_TOTAL, sint)
left_source_1 = Array(CANDIDATE_TOTAL, sint)
left_source_2 = Array(CANDIDATE_TOTAL, sint)
left_source_3 = Array(CANDIDATE_TOTAL, sint)
left_relation_0 = Array(CANDIDATE_TOTAL, sint)
left_relation_1 = Array(CANDIDATE_TOTAL, sint)
left_relation_2 = Array(CANDIDATE_TOTAL, sint)
left_relation_3 = Array(CANDIDATE_TOTAL, sint)
left_target_0 = Array(CANDIDATE_TOTAL, sint)
left_target_1 = Array(CANDIDATE_TOTAL, sint)
left_target_2 = Array(CANDIDATE_TOTAL, sint)
left_target_3 = Array(CANDIDATE_TOTAL, sint)
left_evidence = Array(CANDIDATE_TOTAL, sint)
left_valid = Array(CANDIDATE_TOTAL, sint)
right_source_0 = Array(CANDIDATE_TOTAL, sint)
right_source_1 = Array(CANDIDATE_TOTAL, sint)
right_source_2 = Array(CANDIDATE_TOTAL, sint)
right_source_3 = Array(CANDIDATE_TOTAL, sint)
right_relation_0 = Array(CANDIDATE_TOTAL, sint)
right_relation_1 = Array(CANDIDATE_TOTAL, sint)
right_relation_2 = Array(CANDIDATE_TOTAL, sint)
right_relation_3 = Array(CANDIDATE_TOTAL, sint)
right_target_0 = Array(CANDIDATE_TOTAL, sint)
right_target_1 = Array(CANDIDATE_TOTAL, sint)
right_target_2 = Array(CANDIDATE_TOTAL, sint)
right_target_3 = Array(CANDIDATE_TOTAL, sint)
right_evidence = Array(CANDIDATE_TOTAL, sint)
right_valid = Array(CANDIDATE_TOTAL, sint)
selected_left = Array(TOP_K, sint)
selected_right = Array(TOP_K, sint)

print_ln("query rank left_evidence_handle right_evidence_handle")
@for_range(NUM_QUERIES)
def _(query):
    for party_offset in range(DATA_PARTIES):
        directory_base = party_offset * DIRECTORY_CAPACITY
        source_edge_base = party_offset * SOURCE_EDGE_CAPACITY
        left_found = sint(0)
        left_offset = sint(0)
        left_count = sint(0)
        reverse_found = sint(0)
        reverse_offset = sint(0)
        reverse_count = sint(0)

        for probe in range(PROBE_LIMIT):
            left_slot = source_probe_slots[query * PROBE_LIMIT + probe]
            left_entry = source_directory[directory_base + left_slot]
            left_match = (
                left_entry[11]
                * (left_entry[0] == query_source_0[query])
                * (left_entry[1] == query_source_1[query])
                * (left_entry[2] == query_source_2[query])
                * (left_entry[3] == query_source_3[query])
                * (left_entry[4] == query_relation_1_0[query])
                * (left_entry[5] == query_relation_1_1[query])
                * (left_entry[6] == query_relation_1_2[query])
                * (left_entry[7] == query_relation_1_3[query])
                * (left_entry[8] == query_direction_1[query])
                * (sint(1) - left_found)
            )
            left_offset = left_offset + left_match * left_entry[9]
            left_count = left_count + left_match * left_entry[10]
            left_found = left_found + left_match

            reverse_slot = reverse_probe_slots[query * PROBE_LIMIT + probe]
            reverse_entry = source_directory[directory_base + reverse_slot]
            reverse_match = (
                reverse_entry[11]
                * (reverse_entry[0] == query_target_0[query])
                * (reverse_entry[1] == query_target_1[query])
                * (reverse_entry[2] == query_target_2[query])
                * (reverse_entry[3] == query_target_3[query])
                * (reverse_entry[4] == query_relation_2_0[query])
                * (reverse_entry[5] == query_relation_2_1[query])
                * (reverse_entry[6] == query_relation_2_2[query])
                * (reverse_entry[7] == query_relation_2_3[query])
                * (reverse_entry[8] == query_reverse_direction_2[query])
                * (sint(1) - reverse_found)
                * (sint(1) - target_is_unknown[query])
                * (sint(1) - type_identity_mode[query])
            )
            reverse_offset = reverse_offset + reverse_match * reverse_entry[9]
            reverse_count = reverse_count + reverse_match * reverse_entry[10]
            reverse_found = reverse_found + reverse_match

        for row in range(MAX_CANDIDATES):
            slot = party_offset * MAX_CANDIDATES + row
            left = source_edges[source_edge_base + left_offset + sint(row)]
            left_source_0[slot] = left[0]
            left_source_1[slot] = left[1]
            left_source_2[slot] = left[2]
            left_source_3[slot] = left[3]
            left_relation_0[slot] = left[4]
            left_relation_1[slot] = left[5]
            left_relation_2[slot] = left[6]
            left_relation_3[slot] = left[7]
            left_target_0[slot] = left[8]
            left_target_1[slot] = left[9]
            left_target_2[slot] = left[10]
            left_target_3[slot] = left[11]
            left_evidence[slot] = left[12]
            left_valid[slot] = left_found * (sint(row) < left_count) * left[13]

            reverse = source_edges[source_edge_base + reverse_offset + sint(row)]
            right_source_0[slot] = reverse[8]
            right_source_1[slot] = reverse[9]
            right_source_2[slot] = reverse[10]
            right_source_3[slot] = reverse[11]
            right_relation_0[slot] = reverse[4]
            right_relation_1[slot] = reverse[5]
            right_relation_2[slot] = reverse[6]
            right_relation_3[slot] = reverse[7]
            right_target_0[slot] = reverse[0]
            right_target_1[slot] = reverse[1]
            right_target_2[slot] = reverse[2]
            right_target_3[slot] = reverse[3]
            right_evidence[slot] = reverse[12]
            right_valid[slot] = reverse_found * (sint(row) < reverse_count) * reverse[13]

    for rank in range(TOP_K):
        selected_left[rank] = sint(0)
        selected_right[rank] = sint(0)

    match_prefix_count = sint(0)
    for left in range(CANDIDATE_TOTAL):
        left_ok = (
            left_valid[left]
            * (left_source_0[left] == query_source_0[query])
            * (left_source_1[left] == query_source_1[query])
            * (left_source_2[left] == query_source_2[query])
            * (left_source_3[left] == query_source_3[query])
            * (left_relation_0[left] == query_relation_1_0[query])
            * (left_relation_1[left] == query_relation_1_1[query])
            * (left_relation_2[left] == query_relation_1_2[query])
            * (left_relation_3[left] == query_relation_1_3[query])
        )
        for right in range(CANDIDATE_TOTAL):
            right_ok = (
                right_valid[right]
                * (right_relation_0[right] == query_relation_2_0[query])
                * (right_relation_1[right] == query_relation_2_1[query])
                * (right_relation_2[right] == query_relation_2_2[query])
                * (right_relation_3[right] == query_relation_2_3[query])
                * (right_target_0[right] == query_target_0[query])
                * (right_target_1[right] == query_target_1[query])
                * (right_target_2[right] == query_target_2[query])
                * (right_target_3[right] == query_target_3[query])
            )
            middle_equal = (
                (left_target_0[left] == right_source_0[right])
                * (left_target_1[left] == right_source_1[right])
                * (left_target_2[left] == right_source_2[right])
                * (left_target_3[left] == right_source_3[right])
            )
            known_target_support = (
                left_ok
                * right_ok
                * middle_equal
                * (sint(1) - type_identity_mode[query])
            )
            type_support = left_ok * type_identity_mode[query] * (sint(right) == sint(0))
            support = known_target_support + type_support
            match_prefix_count = match_prefix_count + support
            for rank in range(TOP_K):
                selected = support * (match_prefix_count == sint(rank + 1))
                selected_left[rank] = selected_left[rank] + selected * left_evidence[left]
                selected_right[rank] = (
                    selected_right[rank]
                    + selected * right_evidence[right] * (sint(1) - type_identity_mode[query])
                )

    for rank in range(TOP_K):
        print_ln(
            "%s %s %s %s",
            query,
            rank,
            selected_left[rank].reveal(),
            selected_right[rank].reveal(),
        )
